{
  "name": "oks-sqf",
  "displayName": "OKS SQF — GOL Framework IntelliSense",
  "description": "Hover tooltips, parameter hints, and autocomplete for OKS/GOL SQF framework functions.",
  "version": "0.1.0",
  "publisher": "oksmantv",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "activationEvents": [
    "onLanguage:sqf",
    "workspaceContains:**/*.sqf"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "sqf",
        "extensions": [
          ".sqf",
          ".sqm",
          ".ext",
          ".hpp",
          ".cpp"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.3.0"
  }
}
